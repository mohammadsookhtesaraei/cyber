{
  "plugins": [
    "prettier-plugin-tailwindcss",
    "@trivago/prettier-plugin-sort-imports"
  ],
  "semi": true,
  "singleQuote": true,
  "tabWidth": 2,
  "trailingComma": "es5",
  "bracketSpacing": true,
  "arrowParens": "always",

  "importOrder": [
    "^(next)(/.*)?$",
    "^(react|react-dom)(/.*)?$",
    "^@tanstack(/.*)?$",
    "<THIRD_PARTY_MODULES>",
    "^@/components(/.*)?$",
    "^@/.*$",
    "^.+\\.css$"
  ],

  "importOrderSeparation": true,
  "importOrderSortSpecifiers": true
}